{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "provider": {
    "opencode": {
      "options": {
        "setCacheKey": true
      }
    }
  },
   "permission": {
    "edit": "ask",
    "webfetch": "allow",
    "doom_loop": "ask",
    "external_directory": "ask",
    "read": {
      "*": "allow",
      "*.env.example": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "secrets.json": "deny",
      "secrets.*.json": "deny",
      "*-secrets.yml": "deny",
      "*-secrets.yaml": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.cer": "deny",
      "*.crt": "deny",
      "*.csr": "deny",
      ".ssh/*": "deny",
      "id_rsa": "deny",
      "id_rsa.pub": "deny",
      "id_dsa": "deny",
      "id_dsa.pub": "deny",
      "id_ecdsa": "deny",
      "id_ecdsa.pub": "deny",
      "id_ed25519": "deny",
      "id_ed25519.pub": "deny",
      "known_hosts": "deny",
      "authorized_keys": "deny",
      ".aws/*": "deny",
      ".gcloud/*": "deny",
      ".config/gcloud/*": "deny",
      "*credentials*.json": "deny",
      "*credentials*": "deny",
      "service-account*.json": "deny",
      ".npmrc": "deny",
      ".pypirc": "deny",
      ".docker/config.json": "deny",
      ".kube/config": "deny",
      "kubeconfig": "deny",
      "master.key": "deny",
      ".pgpass": "deny",
      "*.asc": "deny",
      "*.gpg": "deny",
      ".netrc": "deny",
      ".git-credentials": "deny",
      "*token*.txt": "deny",
      "*password*.txt": "deny",
      "terraform.tfvars": "deny",
      "*.tfvars": "deny",
      "terraform.tfstate": "deny",
      "*.ovpn": "deny"
    },
    "bash": {
      "*": "ask",
      "git push*": "ask",
      "git commit*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "which*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "mkdir*": "ask",
      "curl*": "ask",
      "wget*": "ask",
      "npm install*": "ask",
      "brew*": "ask",
      "rm*-r*": "deny",
      "rm*-f*": "deny",
      "rm*--recursive*": "deny",
      "rm*--force*": "deny"
    }
  }
}
