{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "providers": {
    "opencode": {
      "compatibility": {
        "supportsPromptCacheKey": true
      }
    }
  },
  "permission": {
    "read": "allow",
    "external_directory": "ask",
    "bash": {
      "git push *": "ask",
      "git * push *": "ask"
    }
  }
}
