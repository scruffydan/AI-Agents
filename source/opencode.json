{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "providers": {
    "opencode": {
      "compatibility": {
        "supportsPromptCacheKey": true
      }
    }
  },
  "agents": {
    "plan": {
      "permissions": [
        {"action": "edit", "resource": "*", "effect": "deny"},
        {"action": "shell", "resource": "*", "effect": "deny"},
        {"action": "subagent", "resource": "*", "effect": "deny"}
      ]
    },
    "general": {
      "permissions": [
        {"action": "question", "resource": "*", "effect": "deny"},
        {"action": "subagent", "resource": "*", "effect": "deny"}
      ]
    }
  },
  "permissions": [
    {"action": "*", "resource": "*", "effect": "ask"},
    {"action": "read", "resource": "*", "effect": "allow"},
    {"action": "glob", "resource": "*", "effect": "allow"},
    {"action": "question", "resource": "*", "effect": "allow"},
    {"action": "skill", "resource": "*", "effect": "allow"},
    {"action": "webfetch", "resource": "*", "effect": "allow"},
    {"action": "websearch", "resource": "*", "effect": "allow"},
    {"action": "read", "resource": "*.env", "effect": "deny"},
    {"action": "read", "resource": "*.env.*", "effect": "deny"},
    {"action": "read", "resource": ".env.example", "effect": "allow"},
    {"action": "read", "resource": "*/.env.example", "effect": "allow"},
    {"action": "read", "resource": "*.pem", "effect": "deny"},
    {"action": "read", "resource": "*.key", "effect": "deny"},
    {"action": "read", "resource": "*.p12", "effect": "deny"},
    {"action": "read", "resource": "*.pfx", "effect": "deny"},
    {"action": "read", "resource": "*credentials*", "effect": "deny"},
    {"action": "read", "resource": "*token*.txt", "effect": "deny"},
    {"action": "read", "resource": "*password*.txt", "effect": "deny"},
    {"action": "read", "resource": "*.tfvars", "effect": "deny"},
    {"action": "read", "resource": "*.tfvars.json", "effect": "deny"},
    {"action": "read", "resource": "*.tfstate", "effect": "deny"},
    {"action": "read", "resource": "*.tfstate.*", "effect": "deny"},
    {"action": "read", "resource": "*.ovpn", "effect": "deny"},
    {"action": "read", "resource": "*.asc", "effect": "deny"},
    {"action": "read", "resource": "*.gpg", "effect": "deny"},
    {"action": "read", "resource": "secrets.json", "effect": "deny"},
    {"action": "read", "resource": "*/secrets.json", "effect": "deny"},
    {"action": "read", "resource": "secrets.*.json", "effect": "deny"},
    {"action": "read", "resource": "*/secrets.*.json", "effect": "deny"},
    {"action": "read", "resource": "*-secrets.yml", "effect": "deny"},
    {"action": "read", "resource": "*/*-secrets.yml", "effect": "deny"},
    {"action": "read", "resource": "*-secrets.yaml", "effect": "deny"},
    {"action": "read", "resource": "*/*-secrets.yaml", "effect": "deny"},
    {"action": "read", "resource": "id_rsa", "effect": "deny"},
    {"action": "read", "resource": "*/id_rsa", "effect": "deny"},
    {"action": "read", "resource": "id_dsa", "effect": "deny"},
    {"action": "read", "resource": "*/id_dsa", "effect": "deny"},
    {"action": "read", "resource": "id_ecdsa", "effect": "deny"},
    {"action": "read", "resource": "*/id_ecdsa", "effect": "deny"},
    {"action": "read", "resource": "id_ed25519", "effect": "deny"},
    {"action": "read", "resource": "*/id_ed25519", "effect": "deny"},
    {"action": "read", "resource": "service-account*.json", "effect": "deny"},
    {"action": "read", "resource": "*/service-account*.json", "effect": "deny"},
    {"action": "read", "resource": ".npmrc", "effect": "deny"},
    {"action": "read", "resource": "*/.npmrc", "effect": "deny"},
    {"action": "read", "resource": ".pypirc", "effect": "deny"},
    {"action": "read", "resource": "*/.pypirc", "effect": "deny"},
    {"action": "read", "resource": "kubeconfig", "effect": "deny"},
    {"action": "read", "resource": "*/kubeconfig", "effect": "deny"},
    {"action": "read", "resource": "master.key", "effect": "deny"},
    {"action": "read", "resource": "*/master.key", "effect": "deny"},
    {"action": "read", "resource": ".pgpass", "effect": "deny"},
    {"action": "read", "resource": "*/.pgpass", "effect": "deny"},
    {"action": "read", "resource": ".netrc", "effect": "deny"},
    {"action": "read", "resource": "*/.netrc", "effect": "deny"},
    {"action": "read", "resource": ".git-credentials", "effect": "deny"},
    {"action": "read", "resource": "*/.git-credentials", "effect": "deny"},
    {"action": "read", "resource": "terraform.tfstate", "effect": "deny"},
    {"action": "read", "resource": "*/terraform.tfstate", "effect": "deny"},
    {"action": "read", "resource": ".ssh/*", "effect": "deny"},
    {"action": "read", "resource": "*/.ssh/*", "effect": "deny"},
    {"action": "read", "resource": ".aws/*", "effect": "deny"},
    {"action": "read", "resource": "*/.aws/*", "effect": "deny"},
    {"action": "read", "resource": ".gcloud/*", "effect": "deny"},
    {"action": "read", "resource": "*/.gcloud/*", "effect": "deny"},
    {"action": "read", "resource": ".config/gcloud/*", "effect": "deny"},
    {"action": "read", "resource": "*/.config/gcloud/*", "effect": "deny"},
    {"action": "read", "resource": ".docker/*", "effect": "deny"},
    {"action": "read", "resource": "*/.docker/*", "effect": "deny"},
    {"action": "read", "resource": ".kube/*", "effect": "deny"},
    {"action": "read", "resource": "*/.kube/*", "effect": "deny"},
    {"action": "read", "resource": ".gnupg/*", "effect": "deny"},
    {"action": "read", "resource": "*/.gnupg/*", "effect": "deny"},
    {"action": "read", "resource": "auth.json", "effect": "deny"},
    {"action": "read", "resource": "opencode/auth.json", "effect": "deny"},
    {"action": "read", "resource": "*/opencode/auth.json", "effect": "deny"},
    {"action": "shell", "resource": "pwd", "effect": "allow"},
    {"action": "shell", "resource": "ls", "effect": "allow"},
    {"action": "shell", "resource": "ls -la", "effect": "allow"},
    {"action": "shell", "resource": "git status", "effect": "allow"},
    {"action": "shell", "resource": "git status --short", "effect": "allow"},
    {"action": "shell", "resource": "git status --short --branch", "effect": "allow"},
    {"action": "shell", "resource": "git diff --stat", "effect": "allow"},
    {"action": "shell", "resource": "git diff --cached --stat", "effect": "allow"},
    {"action": "shell", "resource": "git log --oneline -10", "effect": "allow"}
  ]
}
